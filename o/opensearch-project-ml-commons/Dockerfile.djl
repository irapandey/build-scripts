FROM registry.access.redhat.com/ubi9/ubi:9.7

# Metadata
LABEL maintainer="Build Scripts Team"
LABEL description="DJL v0.33.0 with PyTorch v2.1.2 for ppc64le"
LABEL version="0.33.0"

# Build arguments
ARG DJL_VERSION=v0.33.0
ARG PYTORCH_VERSION=2.1.2
ARG PYTHON_VERSION=3.9

# Environment variables
ENV DJL_VERSION=${DJL_VERSION}
ENV PYTORCH_VERSION=${PYTORCH_VERSION}
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV BUILD_HOME=/home/builder/djl_build
ENV DJL_HOME=/home/builder/.djl.ai
ENV DJL_INSTALL_PREFIX=/home/builder/.local/djl-pytorch-${PYTORCH_VERSION}
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH=${JAVA_HOME}/bin:${PATH}

# Install system dependencies as root
RUN yum install -y \
    java-21-openjdk-devel \
    wget git unzip make cmake \
    gcc gcc-c++ gcc-gfortran \
    perl python3.9-devel python3.9-pip \
    zlib-devel openssl-devel libffi-devel \
    openblas-devel \
    sudo && \
    yum clean all

# Create builder user with sudo privileges
RUN useradd -m -s /bin/bash builder && \
    echo "builder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to builder user
USER builder
WORKDIR /home/builder

# Install Rust (required for tokenizers)
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y && \
    . $HOME/.cargo/env && \
    rustup install 1.87 && \
    rustup default 1.87

# Add Rust to PATH
ENV PATH="/home/builder/.cargo/bin:${PATH}"

# Copy local wheel files
COPY --chown=builder:builder abseil_cpp-20240116.2-py3-none-any.whl /tmp/
COPY --chown=builder:builder libprotobuf-4.25.3-py3-none-any.whl /tmp/

# Install Python dependencies
RUN python3.9 -m pip install --user packaging "numpy<2.0" wheel setuptools

# Install PyTorch 2.1.2 from IBM wheels
RUN python3.9 -m pip install --user torch==${PYTORCH_VERSION} \
    --prefer-binary \
    --extra-index-url=https://wheels.developerfirst.ibm.com/ppc64le/linux-1.0.0

# Install abseil_cpp from local wheel
RUN python3.9 -m pip install --user /tmp/abseil_cpp-20240116.2-py3-none-any.whl

# Install libprotobuf from local wheel
RUN python3.9 -m pip install --user /tmp/libprotobuf-4.25.3-py3-none-any.whl

# Create build directory
RUN mkdir -p ${BUILD_HOME}

# Clone DJL repository
WORKDIR ${BUILD_HOME}
RUN git clone https://github.com/deepjavalibrary/djl && \
    cd djl && \
    git checkout ${DJL_VERSION}

# Copy and apply DJL patch
COPY --chown=builder:builder djl_v0.33.0.patch /tmp/djl.patch
RUN cd djl && git apply /tmp/djl.patch

# Set up libtorch directory structure
WORKDIR ${BUILD_HOME}/djl
RUN mkdir -p engines/pytorch/pytorch-native/libtorch && \
    cp -r $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/torch/include \
        engines/pytorch/pytorch-native/libtorch/ && \
    cp -r $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/torch/lib \
        engines/pytorch/pytorch-native/libtorch/ && \
    cp -r $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/torch/share \
        engines/pytorch/pytorch-native/libtorch/ && \
    cp -r $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/abseilcpp/lib/* \
        engines/pytorch/pytorch-native/libtorch/lib/

# Set up DJL runtime directory
RUN mkdir -p ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    cp $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/torch/lib/* \
        ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    cp $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/libprotobuf/lib64/libprotobuf.so.25.3.0 \
        ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    sudo cp /usr/lib64/libopenblas.so.0 ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    sudo cp /usr/lib64/libgfortran.so.5 ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    sudo cp /usr/lib64/libquadmath.so.0 ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    cp -r $HOME/.local/lib/python${PYTHON_VERSION}/site-packages/abseilcpp/lib/* \
        ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/

# Create versioned symlinks for abseil libraries
RUN cd ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/ && \
    for f in libabsl_*.so; do \
        if [ -f "$f" ]; then \
            ln -sf $f ${f}.2401.0.0; \
        fi; \
    done

# Set library path for build
ENV LD_LIBRARY_PATH="${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le:${LD_LIBRARY_PATH}"

# Build DJL PyTorch engine
WORKDIR ${BUILD_HOME}/djl
RUN ./gradlew :engines:pytorch:pytorch-native:compileJNI

# Test PyTorch engine (allow failures)
RUN ./gradlew --no-daemon :engines:pytorch:pytorch-engine:test \
    -Dengine.pytorch.disable_native_extraction=true \
    -Djava.library.path=${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le || \
    echo "Warning: Some PyTorch engine tests failed, continuing..."

# Build tokenizers
RUN ./gradlew :extensions:tokenizers:compileJNI

# Test tokenizers (allow failures)
RUN ./gradlew --no-daemon :extensions:tokenizers:test \
    -Dengine.pytorch.disable_native_extraction=true \
    -Djava.library.path=${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le \
    -Dai.djl.debug=true || \
    echo "Warning: Some tokenizer tests failed, continuing..."

# Publish to Maven local
RUN ./gradlew -Prelease=true publishToMavenLocal

# Build BOM
WORKDIR ${BUILD_HOME}/djl/bom
RUN ./gradlew build && \
    ./gradlew -Prelease=true publishToMavenLocal

# Create installation package
RUN mkdir -p ${DJL_INSTALL_PREFIX}/lib && \
    mkdir -p ${DJL_INSTALL_PREFIX}/maven && \
    cp -r ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/* ${DJL_INSTALL_PREFIX}/lib/ && \
    if [ -d "$HOME/.m2/repository/ai/djl" ]; then \
        cp -r $HOME/.m2/repository/ai/djl ${DJL_INSTALL_PREFIX}/maven/; \
    fi

# Create environment setup script
RUN echo '#!/bin/bash' > ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo '# Source this file to set up environment for DJL PyTorch' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo '' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo "PYTORCH_VERSION=\"${PYTORCH_VERSION}\"" >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'DJL_INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'DJL_HOME="${HOME}/.djl.ai"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo '' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'export LD_LIBRARY_PATH="${DJL_INSTALL_DIR}/lib:${LD_LIBRARY_PATH}"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'export JAVA_OPTS="${JAVA_OPTS} -Dorg.opensearch.djl.pytorch.path=${DJL_INSTALL_DIR}/lib"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'export JAVA_OPTS="${JAVA_OPTS} -Djava.library.path=${DJL_INSTALL_DIR}/lib"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'export JAVA_OPTS="${JAVA_OPTS} -Dengine.pytorch.disable_native_extraction=true"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo '' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'echo "DJL PyTorch environment configured:"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'echo "  Install directory: ${DJL_INSTALL_DIR}"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'echo "  Library path: ${DJL_INSTALL_DIR}/lib"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    echo 'echo "  PyTorch version: ${PYTORCH_VERSION}"' >> ${DJL_INSTALL_PREFIX}/setup-env.sh && \
    chmod +x ${DJL_INSTALL_PREFIX}/setup-env.sh

# Create README
RUN echo "# DJL PyTorch v${PYTORCH_VERSION} for ppc64le" > ${DJL_INSTALL_PREFIX}/README.md && \
    echo "" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "This package contains DJL ${DJL_VERSION} built with PyTorch ${PYTORCH_VERSION} for ppc64le architecture." >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "## Installation" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "The DJL artifacts have been published to Maven local repository (~/.m2/repository)." >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "## Usage" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "Source the environment setup script:" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo '```bash' >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo "source ${DJL_INSTALL_PREFIX}/setup-env.sh" >> ${DJL_INSTALL_PREFIX}/README.md && \
    echo '```' >> ${DJL_INSTALL_PREFIX}/README.md

# Create output directory
RUN mkdir -p /home/builder/output

# Create entrypoint script
RUN echo '#!/bin/bash' > /home/builder/entrypoint.sh && \
    echo 'set -e' >> /home/builder/entrypoint.sh && \
    echo '' >> /home/builder/entrypoint.sh && \
    echo 'echo "=========================================="' >> /home/builder/entrypoint.sh && \
    echo 'echo "DJL Build Complete!"' >> /home/builder/entrypoint.sh && \
    echo 'echo "=========================================="' >> /home/builder/entrypoint.sh && \
    echo 'echo ""' >> /home/builder/entrypoint.sh && \
    echo 'echo "Installation directory: ${DJL_INSTALL_PREFIX}"' >> /home/builder/entrypoint.sh && \
    echo 'echo "Maven artifacts: ~/.m2/repository/ai/djl/"' >> /home/builder/entrypoint.sh && \
    echo 'echo "Runtime libraries: ${DJL_HOME}/pytorch/${PYTORCH_VERSION}-cpu-linux-ppc64le/"' >> /home/builder/entrypoint.sh && \
    echo 'echo ""' >> /home/builder/entrypoint.sh && \
    echo '' >> /home/builder/entrypoint.sh && \
    echo '# Copy artifacts to output if directory is mounted' >> /home/builder/entrypoint.sh && \
    echo 'if [ -d "/output" ]; then' >> /home/builder/entrypoint.sh && \
    echo '    echo "Copying DJL artifacts to /output..."' >> /home/builder/entrypoint.sh && \
    echo '    cp -r ${DJL_INSTALL_PREFIX} /output/' >> /home/builder/entrypoint.sh && \
    echo '    cp -r $HOME/.m2/repository/ai/djl /output/maven-artifacts/' >> /home/builder/entrypoint.sh && \
    echo '    echo "Artifacts copied to /output"' >> /home/builder/entrypoint.sh && \
    echo 'fi' >> /home/builder/entrypoint.sh && \
    echo '' >> /home/builder/entrypoint.sh && \
    echo 'echo ""' >> /home/builder/entrypoint.sh && \
    echo 'echo "To use this DJL build:"' >> /home/builder/entrypoint.sh && \
    echo 'echo "  1. Copy artifacts from /output (if mounted)"' >> /home/builder/entrypoint.sh && \
    echo 'echo "  2. Or extract from container: docker cp <container>:${DJL_INSTALL_PREFIX} ."' >> /home/builder/entrypoint.sh && \
    echo 'echo ""' >> /home/builder/entrypoint.sh && \
    echo '' >> /home/builder/entrypoint.sh && \
    echo '# Keep container running if requested' >> /home/builder/entrypoint.sh && \
    echo 'if [ "$1" = "--keep-alive" ]; then' >> /home/builder/entrypoint.sh && \
    echo '    echo "Container will stay alive. Use docker exec to interact."' >> /home/builder/entrypoint.sh && \
    echo '    tail -f /dev/null' >> /home/builder/entrypoint.sh && \
    echo 'fi' >> /home/builder/entrypoint.sh && \
    chmod +x /home/builder/entrypoint.sh

WORKDIR /home/builder

# Set entrypoint
ENTRYPOINT ["/home/builder/entrypoint.sh"]

# Default command
CMD []

# Usage:
# Build: docker build -t djl-pytorch-builder -f Dockerfile.djl .
# Run:   docker run -v $(pwd)/output:/output djl-pytorch-builder
# Keep alive: docker run -d --name djl-builder djl-pytorch-builder --keep-alive
# Extract: docker cp djl-builder:/home/builder/.local/djl-pytorch-2.1.2 ./djl-install

# Made with Bob
