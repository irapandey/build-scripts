FROM djl-pytorch-builder AS djl-source

# ============================================================================
# Build ml-commons using pre-built DJL from djl-pytorch-builder image
# ============================================================================
FROM registry.access.redhat.com/ubi9/ubi:9.7

# Build arguments
ARG PACKAGE_VERSION=3.5.0.0
ARG ONNX_VERSION=v1.17.1
ARG PYTORCH_VERSION=2.1.2
ARG PYTHON_VERSION=3.9

# Environment variables
ENV PACKAGE_VERSION=${PACKAGE_VERSION}
ENV ONNX_VERSION=${ONNX_VERSION}
ENV PYTORCH_VERSION=${PYTORCH_VERSION}
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV BUILD_HOME=/home/tester/build_workspace
ENV DJL_HOME=/home/tester/.djl.ai
ENV DJL_INSTALL_PREFIX=/home/tester/.local/djl-pytorch-${PYTORCH_VERSION}
ENV SCRIPT_PATH=/home/tester/scripts

# Install dependencies
RUN yum install -y \
    java-17-openjdk-devel \
    java-21-openjdk-devel \
    wget git sudo unzip make cmake \
    gcc gcc-c++ gcc-gfortran \
    perl python3.9-devel python3.9-pip \
    zlib-devel openssl-devel libffi-devel \
    openblas-devel && \
    yum clean all

# Create test_user
RUN useradd -m -s /bin/bash test_user && \
    echo "test_user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/tester && \
    chown -R test_user:test_user /home/tester

USER test_user
WORKDIR /home/tester

# Copy DJL artifacts from pre-built image
COPY --from=djl-source --chown=test_user:test_user /home/builder/.local/djl-pytorch-${PYTORCH_VERSION} ${DJL_INSTALL_PREFIX}
COPY --from=djl-source --chown=test_user:test_user /home/builder/.djl.ai ${DJL_HOME}

# Copy Maven repository to test_user's home directory (where $HOME points)
RUN mkdir -p /home/test_user/.m2
COPY --from=djl-source --chown=test_user:test_user /home/builder/.m2/repository /home/test_user/.m2/repository

# Also copy to /home/tester for consistency with other paths
RUN mkdir -p /home/tester/.m2
COPY --from=djl-source --chown=test_user:test_user /home/builder/.m2/repository /home/tester/.m2/repository

# Verify Maven artifacts were copied
RUN echo "Verifying Maven artifacts..." && \
    echo "Checking /home/test_user/.m2/repository/ai/djl..." && \
    ls -la /home/test_user/.m2/repository/ai/djl/ && \
    echo "✓ DJL Maven artifacts found in test_user home"

# Copy build scripts and patches
RUN mkdir -p ${SCRIPT_PATH}
COPY --chown=test_user:test_user ml-commons_3.5.0.0_ubi9.7.sh ${SCRIPT_PATH}/
COPY --chown=test_user:test_user ml-commons_3.5.0.0.patch ${SCRIPT_PATH}/
COPY --chown=test_user:test_user onnxruntime_v1.17.1.patch ${SCRIPT_PATH}/
COPY --chown=test_user:test_user djl_v0.33.0.patch ${SCRIPT_PATH}/
COPY --chown=test_user:test_user abseil_cpp-20240116.2-py3-none-any.whl ${SCRIPT_PATH}/
COPY --chown=test_user:test_user libprotobuf-4.25.3-py3-none-any.whl ${SCRIPT_PATH}/

# Create artifacts directory
RUN mkdir -p /home/tester/artifacts

# Create build script
RUN echo '#!/bin/bash' > /home/tester/build.sh && \
    echo 'set -e' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo 'echo "=========================================="' >> /home/tester/build.sh && \
    echo 'echo "Building ml-commons with pre-built DJL"' >> /home/tester/build.sh && \
    echo 'echo "=========================================="' >> /home/tester/build.sh && \
    echo 'echo "DJL Location: ${DJL_INSTALL_PREFIX}"' >> /home/tester/build.sh && \
    echo 'echo "Maven artifacts: ~/.m2/repository/ai/djl/"' >> /home/tester/build.sh && \
    echo 'echo ""' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo '# Verify DJL is available' >> /home/tester/build.sh && \
    echo 'if [ ! -d "${DJL_INSTALL_PREFIX}" ]; then' >> /home/tester/build.sh && \
    echo '    echo "ERROR: DJL installation not found at ${DJL_INSTALL_PREFIX}"' >> /home/tester/build.sh && \
    echo '    exit 1' >> /home/tester/build.sh && \
    echo 'fi' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo 'if [ ! -d "$HOME/.m2/repository/ai/djl" ]; then' >> /home/tester/build.sh && \
    echo '    echo "ERROR: DJL Maven artifacts not found"' >> /home/tester/build.sh && \
    echo '    exit 1' >> /home/tester/build.sh && \
    echo 'fi' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo 'echo "✓ DJL installation verified"' >> /home/tester/build.sh && \
    echo 'echo "✓ Maven artifacts verified"' >> /home/tester/build.sh && \
    echo 'echo ""' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo '# Source DJL environment' >> /home/tester/build.sh && \
    echo 'export LD_LIBRARY_PATH="${DJL_INSTALL_PREFIX}/lib:${LD_LIBRARY_PATH}"' >> /home/tester/build.sh && \
    echo 'export JAVA_OPTS="-Dorg.opensearch.djl.pytorch.path=${DJL_INSTALL_PREFIX}/lib"' >> /home/tester/build.sh && \
    echo 'export JAVA_OPTS="${JAVA_OPTS} -Djava.library.path=${DJL_INSTALL_PREFIX}/lib"' >> /home/tester/build.sh && \
    echo 'export JAVA_OPTS="${JAVA_OPTS} -Dengine.pytorch.disable_native_extraction=true"' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo '# Run ml-commons build with pre-built DJL flag' >> /home/tester/build.sh && \
    echo 'cd /home/tester' >> /home/tester/build.sh && \
    echo 'bash ${SCRIPT_PATH}/ml-commons_3.5.0.0_ubi9.7.sh --use-prebuilt-djl "$@"' >> /home/tester/build.sh && \
    echo '' >> /home/tester/build.sh && \
    echo '# Copy artifacts' >> /home/tester/build.sh && \
    echo 'if [ -d "/output" ]; then' >> /home/tester/build.sh && \
    echo '    echo ""' >> /home/tester/build.sh && \
    echo '    echo "Copying artifacts to /output..."' >> /home/tester/build.sh && \
    echo '    sudo chmod 777 /output 2>/dev/null || true' >> /home/tester/build.sh && \
    echo '    cp -r /home/tester/artifacts/* /output/ 2>/dev/null || true' >> /home/tester/build.sh && \
    echo '    echo "Build completed. Artifacts copied to /output"' >> /home/tester/build.sh && \
    echo 'else' >> /home/tester/build.sh && \
    echo '    echo ""' >> /home/tester/build.sh && \
    echo '    echo "Build completed. Artifacts available in /home/tester/artifacts"' >> /home/tester/build.sh && \
    echo 'fi' >> /home/tester/build.sh && \
    chmod +x /home/tester/build.sh

ENTRYPOINT ["/bin/bash", "/home/tester/build.sh"]
CMD []

# Usage:
# Prerequisites: Build DJL image first
#   docker build -t djl-pytorch-builder -f Dockerfile.djl .
#
# Build ml-commons:
#   docker build -t ml-commons-builder -f Dockerfile.ml-commons-prebuilt .
#
# Run:
#   mkdir -p output && chmod 777 output
#   docker run -v $(pwd)/output:/output ml-commons-builder
#
# Skip tests:
#   docker run -v $(pwd)/output:/output ml-commons-builder --skip-tests

